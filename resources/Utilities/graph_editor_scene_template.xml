<!-- Template for a lit scene in testrender, used by the graph editor OSL preview.
     %input_shader_type% is replaced with the name of the shader to render.
     %camera_eye%, %camera_look_at%, %camera_up% and %camera_fov% are replaced
     with the interactive camera state. -->
<World>
    <Camera eye="%camera_eye%" look_at="%camera_look_at%" up="%camera_up%" fov="%camera_fov%" />

    <!-- Camera-independent backdrop so the subject can be orbited freely.
         testrender evaluates the background shader only for camera rays that
         miss geometry, so it adds no occlusion or lighting cost. -->
    <ShaderGroup name="backdrop">
        color Cs 0.5 0.5 0.5; shader graph_editor_background layer1;
    </ShaderGroup>
    <Background resolution="0" />

    <!-- Key light, left, facing +x -->
    <ShaderGroup name="emitterLeft" is_light="yes">
        float power 400; shader emitter layer1
    </ShaderGroup>
    <Quad corner="-6,0,2" edge_x="0,0,-4" edge_y="0,4,0" />

    <!-- Top light, facing down -->
    <ShaderGroup name="emitterTop" is_light="yes">
        float power 400; shader emitter layer1
    </ShaderGroup>
    <Quad corner="-2,8,-2" edge_x="4,0,0" edge_y="0,0,4" />

    <!-- The ball -->
    <ShaderGroup name="ball">
        shader %input_shader_type% layer1;
    </ShaderGroup>
    <Sphere center="0,1,0" radius="1" />
</World>
